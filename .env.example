# O MVP usa armazenamento em memória.
# Não coloque senhas ou tokens reais neste arquivo versionado.
# Diretório local e privado para fotos do VoltaPraMim.
# Não use uma pasta dentro de src/main/webapp.
#
# Exemplo Windows:
# VPM_FOTOS_DIR=C:\Users\SEU_USUARIO\voltapramim-fotos
#
# Exemplo macOS/Linux:
# VPM_FOTOS_DIR=/home/seu_usuario/voltapramim-fotos
#
# Se não for configurada, a aplicação usa a pasta temporária do sistema.
VPM_FOTOS_DIR=

# Senha de demonstração para acesso ao painel /operacoes (simulação acadêmica).
# Defina no ambiente local antes de iniciar o servidor (nunca versione a senha real).
#
# Exemplo Windows PowerShell:
# $env:VPM_OPERACOES_SENHA="sua-senha-local"
#
# Exemplo macOS/Linux:
# export VPM_OPERACOES_SENHA="sua-senha-local"
VPM_OPERACOES_SENHA=